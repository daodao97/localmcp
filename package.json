{
  "name": "@daodao97/localmcp",
  "version": "0.3.0",
  "description": "Local MCP bridge for ChatGPT with files, shell, skills, pluggable MCP servers and multiple workspaces",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "localmcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "src/relay-protocol.ts",
    "skills/",
    "scripts/",
    "worker/",
    "localmcp.example.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/agent.js",
    "stdio": "node dist/index.js stdio",
    "http": "node dist/index.js http",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm test && npm run build",
    "start:quick": "node dist/launch.js",
    "worker:setup": "node scripts/worker-setup.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:secrets": "wrangler secret bulk .localmcp/worker-secrets.json --config worker/wrangler.jsonc"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/daodao97/locamcp.git"
  },
  "bugs": {
    "url": "https://github.com/daodao97/locamcp/issues"
  },
  "homepage": "https://github.com/daodao97/locamcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chatgpt",
    "local",
    "agent",
    "skills"
  ],
  "author": "daodao97",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.0"
  }
}
